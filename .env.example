BACKEND_URL=
BACKEND_API_TOKEN=

# PostHog session replay, read by the admin server only.
#
# POSTHOG_PERSONAL_API_KEY can read and write everything in the project,
# so it must never be given a NEXT_PUBLIC_ prefix — that prefix is the
# instruction to inline a value into the browser bundle. src/lib/posthog.ts
# imports "server-only" so that mistake fails the build instead.
#
# POSTHOG_APP_HOST is where recordings are watched (e.g.
# https://us.posthog.com), which is not the ingest host the shop sends to.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_APP_HOST=
